rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — the disability/preference profile built during
    // onboarding (Module 1) and mutated afterwards only via Gemini
    // function-calling or the paired Caretaker's remote toggles (Module 2+).
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || resource.data.pairedUserId == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      // `role` is set at account creation and promoted to a verified custom
      // claim by the onUserRoleWritten Cloud Function. Allowing the client
      // to change it lets users switch roles by going back in onboarding.
      allow update: if request.auth != null && request.auth.uid == uid;
      // Lets the OTHER party in a pairing transaction stamp their own uid
      // onto this profile's `pairedUserId` once. uids aren't guessable, and
      // single-use/expiry gating already happened via the pairingCodes/{code}
      // update rule in the same transaction — this rule only allows that one
      // field to change, and only while the profile is still unpaired.
      allow update: if request.auth != null && request.auth.uid != uid &&
        resource.data.pairedUserId == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairedUserId']) &&
        request.resource.data.pairedUserId == request.auth.uid;
      // Remote Management (Module 2): the paired Caretaker gets a normal
      // settings menu to edit the Disabled User's profile directly — the
      // one place besides the owner themself that may touch these fields.
      // `role`, `uid`, and `pairedUserId` stay off-limits even to the
      // caretaker (role/uid are immutable; pairedUserId is only ever set by
      // the pairing transaction above).
      allow update: if request.auth != null && request.auth.uid != uid &&
        resource.data.pairedUserId == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pairedUserId == resource.data.pairedUserId;
    }

    // pairingCodes/{code} — short-lived Caretaker<->Disabled User pairing.
    // Anyone signed in may attempt to redeem a code (they don't know which
    // uid it belongs to ahead of time); only the creating Caretaker's own
    // client ever creates one.
    match /pairingCodes/{code} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.caretakerUid;
      allow get: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.disabledUserUid == null &&
        request.resource.data.disabledUserUid == request.auth.uid;
    }

    // liveLocations/{disabledUserUid} — Overwatch Map (Module 2 UI, written
    // by the Virtual Guardian background isolate in Module 8). Only the
    // Disabled User's own device ever writes their location; the paired
    // Caretaker may only read it.
    match /liveLocations/{disabledUserUid} {
      allow read: if request.auth != null &&
        (request.auth.uid == disabledUserUid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedUserId == disabledUserUid);
      allow write: if request.auth != null && request.auth.uid == disabledUserUid;
    }

    // alerts/{disabledUserUid}/items/{alertId} — Alert Center (Module 2 UI,
    // populated by the Virtual Guardian / Magic Button in Modules 8-9).
    // Alerts are always created by the Disabled User's own device (that's
    // whose client detects the trigger); only the paired Caretaker may mark
    // one resolved.
    match /alerts/{disabledUserUid}/items/{alertId} {
      allow read: if request.auth != null &&
        (request.auth.uid == disabledUserUid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedUserId == disabledUserUid);
      allow create: if request.auth != null && request.auth.uid == disabledUserUid;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedUserId == disabledUserUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt']);
    }

    // communications/{disabledUserUid}/messages/{messageId} — Communication
    // Hub (Module 2): Async Memos and Snapshot Requests between a Disabled
    // User and their paired Caretaker. Keyed by the Disabled User's uid so
    // both parties read the same subcollection.
    match /communications/{disabledUserUid}/messages/{messageId} {
      allow read: if request.auth != null &&
        (request.auth.uid == disabledUserUid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedUserId == disabledUserUid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid &&
        (request.auth.uid == disabledUserUid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairedUserId == disabledUserUid);
    }

    // hazardReports/{reportId} — Crowdsource Reporting Hub. Readable by any
    // signed-in user since these drive everyone's routing safety scores,
    // not just the reporter's.
    //
    // Create only, and only under the caller's own uid: the Red Flag
    // anti-spam rule counts *distinct reporters* (Module 5, Step 2), so a
    // client able to write someone else's `reporterUid` could manufacture a
    // confirmed hazard alone and close a road for every user of the app.
    // No update/delete either — a report is evidence; expiry, resolution
    // and aggregation are all done by Cloud Functions through the Admin SDK
    // (which bypasses these rules), never by a client editing history.
    match /hazardReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterUid;
      allow update, delete: if false;
    }

    // hazardZones/{zoneId} — Module 5's aggregated view of the above: one
    // document per clustered hazard, carrying the flag level and $w_2$
    // weight routing actually reads. Written only by
    // `onHazardReportCreated`/`decayHazardZones`/`resolveHazardZone` via the
    // Admin SDK. Client-writable would defeat the entire anti-spam layer in
    // one step — the aggregate is precisely the thing users must not be
    // able to set directly.
    // busRoutes/{routeNumber} — Module 6's known Dhaka transit routes, keyed
    // by route number as ASCII digits ("6", not "৬"; the client normalises).
    // Fields: destinationEn, destinationBn, via[].
    //
    // Read-only to clients, and that matters more here than it looks. This
    // collection exists specifically to *override* what the vision model read
    // off a signboard: measured on a degraded image, the model kept the route
    // number and corrupted the destination, so the number is used as a key and
    // the names come from here instead (see `VisionConfig.busRouteLookupWins`).
    // A client-writable row would therefore let any signed-in device decide
    // what a blind user is told a bus's destination is — with the app stating
    // it more confidently than the unverified reading it replaced.
    match /busRoutes/{routeNumber} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /hazardZones/{zoneId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // crimeZones/{thanaSlug} — Module 4's static Thana crime baseline
    // (boundary polygon + Crime_Score). Public safety data, read-only from
    // the client; only written by the `seedCrimeZones`/`scrapeDmpCrimeReports`
    // Cloud Functions, which use the Admin SDK and bypass these rules
    // entirely — so `allow write: if false` here is just making that
    // explicit, not the actual enforcement mechanism.
    match /crimeZones/{thanaId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // thanaAdvisories/{id} + socialSignals/{id} — current, sourced risk
    // elevation for a single thana (news articles and corroborated social
    // posts), and the raw posts behind the social tier.
    //
    // Read-only to clients and written exclusively by
    // `recordThanaAdvisory`/`recordSocialSignal` through the Admin SDK.
    // This matters more than for the other public collections: a
    // client-writable advisory would let any signed-in device mark a real
    // Dhaka neighbourhood dangerous for every user of the app, with no
    // source and no way for anyone to notice. The callables enforce
    // mandatory provenance (`validateAdvisory`/`validateSignal`) and the
    // corroboration threshold; a direct write path would bypass both.
    match /thanaAdvisories/{advisoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /socialSignals/{signalId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // thanaIncidents/{id} — the ledger of individual crime stories matched
    // to a thana, which the hourly sweep turns into the learned baseline's
    // evidence months.
    //
    // Same rule and the same reason as advisories, with one more: incidents
    // are the *long* memory. An advisory expires within weeks; a fabricated
    // incident would sit in the ledger for two years, quietly counting
    // toward a permanent-feeling label on a real neighbourhood where real
    // people live. Written only by `recordThanaIncident` via the Admin SDK,
    // which requires a citable URL and a real publication date, and is
    // idempotent per source so the same story cannot be counted twice.
    match /thanaIncidents/{incidentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // cityTrend/{period} + meta/cityTrendMultiplier — Module 4's citywide
    // crime-trend history and the multiplier derived from it (see
    // `scrapeDmpCrimeReports`/`updateCityTrendMultiplier` in
    // functions/index.js). Same public-data, function-writes-only pattern
    // as crimeZones.
    match /cityTrend/{period} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // api_usage/{YYYY-MM} — the client-side Google Maps free-tier counter
    // (see `api_budget.dart`). One document per calendar month, one integer
    // field per billable API.
    //
    // Client-writable, which is unusual here and is a deliberate trade. The
    // counter's job is to stop the *app* overspending, and the app is the
    // only thing that knows a call was made — Google exposes no usage figure
    // a Cloud Function could read. Routing it through a callable function
    // would put a second billable round trip in front of every route request
    // to protect a number that is already only advisory.
    //
    // The exposure is bounded by what the shape allows: increments only, no
    // deletes, and no way to lower a count. A malicious client can therefore
    // make the app *stop* calling Google — degrading everyone to
    // OpenStreetMap — but cannot make it spend more, which is the direction
    // that costs money. That asymmetry is the whole reason this is
    // acceptable.
    match /api_usage/{period} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
