<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared here, not just in the debug/profile source sets (where the
         Flutter template puts it, purely for the dev-time VM connection).
         Everything this app does off-device — Firebase, Gemini, Cloud
         STT/TTS, OpenStreetMap tiles, OSRM routing — needs it in release
         builds too. It currently also arrives transitively via the Firebase
         AARs' own manifests, so release builds aren't broken today, but
         relying on a transitive dependency for the app's own core
         permission is not something to leave to chance. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- AI Assistant module (voice input) and Guardian voice memos both
         need the mic; speech recognition itself is on-device, no separate
         permission beyond RECORD_AUDIO is required on Android. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Module 3's background/lock-screen "Hey ANT" listening — see
         WakeWordForegroundService's doc comment. FOREGROUND_SERVICE_MICROPHONE
         is required to declare a microphone-associated foreground service on
         Android 14+ even though the service itself never opens the mic (the
         Dart-side recorder does); POST_NOTIFICATIONS is required at runtime
         on Android 13+ for the ongoing notification to actually show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Module 9, the Magic Button.

         SEND_SMS is here because the alternative does not work for the
         people this exists for. An `sms:` intent opens the messaging app
         pre-filled and waits for someone to find and press send — which a
         blind user in a panic cannot do, and which defeats the entire point
         of a trigger you can hit without looking. Cellular SMS also keeps
         working when data does not, which is the other half of why this
         module uses it at all.

         Note for whoever submits this to Google Play: SEND_SMS is a
         restricted permission and a navigation app will very likely be
         refused it. The fallback at that point is a server-side SMS
         gateway, which costs the offline guarantee. Sideloaded and App
         Distribution builds are unaffected.

         CALL_PHONE places the follow-up call directly rather than dropping
         the user into a dialler they would then have to operate. -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <application
        android:label="ant_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".WakeWordForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Renders with Skia instead of Impeller.

             Impeller silently drops the OSM raster tiles on Adreno 6xx: the
             tiles download (HTTP 200, valid PNGs, 2.5 MB pulled in one
             session) and `errorTileCallback` never fires, but nothing is
             painted, so the map shows as a blank grey panel. Vector layers
             on the same map — the route polyline, the location dot — draw
             correctly, which is what made this look like a data problem
             rather than a rendering one for so long.

             Reproduced and fixed on a Redmi 10C (Adreno 610, MIUI 14):
             identical build, this line the only difference, blank grey ->
             full map. That class of device is not an edge case for this
             app — a budget Xiaomi is the typical handset for the users it
             is being built for in Dhaka.

             Flutter now prints "Impeller opt-out deprecated" on boot, so
             this escape hatch is on its way out. When it goes, the fallback
             is a tile provider that decodes to `dart:ui.Image` itself
             rather than relying on the default image pipeline. Revisit on
             the next Flutter upgrade; until then a deprecation warning is a
             far better outcome than a blind user's map being blank. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBhpaxU8ZdJ-3xGt-fTRfChMa5zIwEJiYI" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
